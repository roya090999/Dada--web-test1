<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Roya Dada – 5R</title>
</head>

<body style="background-color: yellow;">

    <h1>Roya Dada – 5R</h1>

    <h2>Persönliche Daten</h2>

    <p>
        Geburtsdatum: 21.01.2011<br>
        Lieblingsfarbe: Gelb
    </p>

    <h2>Meine Lieblingsfächer</h2>

    <ol>
        <li>Englisch</li>
        <li>Biologie</li>
        <li>Sport</li>
    </ol>

    <h2>Meine Hobbys</h2>

    <ul id="liste-hobbys"></ul>


        src="img/bild1.jpg"
        width="400"
        title="Freies Bild"
        alt="Mädchen beim Eislaufen"
    >

    <figcaption>
        Bildquelle:
        <a href="https://pxhere.com/de/photo/1354803" target="_blank">
            Foto auf PxHere
        </a>
        —
        Lizenz:
        <a href="https://creativecommons.org/publicdomain/zero/1.0/" target="_blank">
            CC0 Public Domain
        </a>
    </figcaption>

    </figure>

    <script>
        const hobbys = ["Singen", "Reiten", "Eislaufen", "Roya Dada"];

        const liste = document.getElementById("liste-hobbys");

        hobbys.forEach(h => {
            let li = document.createElement("li");
            li.textContent = h;
            liste.appendChild(li);
        });
    </script>

</body>
</html>
